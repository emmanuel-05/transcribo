# Modèle de fichier d'environnement (.env)
# NE PAS METTRE DE VRAIES CLÉS SECRÈTES ICI !

# Configuration Base de Données
DATABASE_URL=postgresql+asyncpg://user:password@host:port/dbname

# Configuration Redis
REDIS_URL=redis://host:port

# Sécurité
SECRET_KEY=votre_cle_secrete_super_securisee

# Clés d'API Externes
DEEPGRAM_API_KEY=votre_cle_api_deepgram
GROQ_API_KEY=votre_cle_api_groq
CONVERTIO_API_KEY=votre_cle_api_convertio

# Configuration S3 / MinIO
S3_ENDPOINT=http://host:port
S3_ACCESS_KEY=votre_access_key
S3_SECRET_KEY=votre_secret_key
