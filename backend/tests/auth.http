@baseUrl = http://127.0.0.1:8000

# ─── INSCRIPTION ──────────────────────────────────
# @name register
POST {{baseUrl}}/api/v1/auth/register
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "secret123",
  "full_name": "Jean Test"
}

###

# ─── CONNEXION ────────────────────────────────────
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "email": "test@example.com",
  "password": "secret123"
}

###

# ─── PROFIL ───────────────────────────────────────
# @name me
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{login.response.body.access_token}}

###

# ============================================================
# PROJETS
# ============================================================

# ─── LISTER LES PROJETS ──────────────────────────
# @name listProjects
GET {{baseUrl}}/api/v1/projects/
Authorization: Bearer {{login.response.body.access_token}}

###

# ─── CRÉER UN PROJET ─────────────────────────────
# @name createProject
POST {{baseUrl}}/api/v1/projects/
Content-Type: application/json
Authorization: Bearer {{login.response.body.access_token}}

{
  "name": "Projet Test",
  "description": "Description du projet test"
}

###

# ─── VOIR UN PROJET ──────────────────────────────
# @name getProject
GET {{baseUrl}}/api/v1/projects/{{createProject.response.body.id}}
Authorization: Bearer {{login.response.body.access_token}}

###

# ─── MODIFIER UN PROJET ──────────────────────────
# @name updateProject
PATCH {{baseUrl}}/api/v1/projects/{{createProject.response.body.id}}
Content-Type: application/json
Authorization: Bearer {{login.response.body.access_token}}

{
  "name": "Projet modifié",
  "description": "Nouvelle description"
}

###

# ============================================================
# AUDIOS
# ============================================================

# ─── UPLOAD AUDIO ─────────────────────────────────
# @name uploadAudio
POST {{baseUrl}}/api/v1/projects/{{createProject.response.body.id}}/audios
Authorization: Bearer {{login.response.body.access_token}}
Content-Type: multipart/form-data; boundary=----boundary

------boundary
Content-Disposition: form-data; name="file"; filename="test.wav"
Content-Type: audio/wav

< /chemin/vers/votre/fichier/test.wav
------boundary--

###

# ─── LISTER LES AUDIOS ────────────────────────────
# @name listAudios
GET {{baseUrl}}/api/v1/projects/{{createProject.response.body.id}}/audios
Authorization: Bearer {{login.response.body.access_token}}

###

# ─── URL D'ÉCOUTE ─────────────────────────────────
# @name audioUrl
GET {{baseUrl}}/api/v1/projects/{{createProject.response.body.id}}/audios/{{uploadAudio.response.body.id}}/url
Authorization: Bearer {{login.response.body.access_token}}

###

# ─── TÉLÉCHARGER ──────────────────────────────────
# @name downloadAudio
GET {{baseUrl}}/api/v1/projects/{{createProject.response.body.id}}/audios/{{uploadAudio.response.body.id}}/download
Authorization: Bearer {{login.response.body.access_token}}

###

# ─── LANCER LA TRANSCRIPTION ──────────────────────
# @name transcribe
POST {{baseUrl}}/api/v1/projects/{{createProject.response.body.id}}/audios/{{uploadAudio.response.body.id}}/transcribe
Authorization: Bearer {{login.response.body.access_token}}

###

# ─── RÉSULTAT TRANSCRIPTION ───────────────────────
# @name transcript
GET {{baseUrl}}/api/v1/projects/{{createProject.response.body.id}}/audios/{{uploadAudio.response.body.id}}/transcript
Authorization: Bearer {{login.response.body.access_token}}

###

# ─── SUPPRIMER UN AUDIO ───────────────────────────
# @name deleteAudio
DELETE {{baseUrl}}/api/v1/projects/{{createProject.response.body.id}}/audios/{{uploadAudio.response.body.id}}
Authorization: Bearer {{login.response.body.access_token}}

###

# ============================================================
# NETTOYAGE
# ============================================================

# ─── SUPPRIMER LE PROJET ──────────────────────────
# @name deleteProject
DELETE {{baseUrl}}/api/v1/projects/{{createProject.response.body.id}}
Authorization: Bearer {{login.response.body.access_token}}